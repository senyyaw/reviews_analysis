.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

# Raw Apple pages contain reviewer user names; keep them local only (pool.jsonl stores hashes).
data/snapshots/**/raw/

# Fine-tuned PyTorch checkpoints are large; only the int8 ONNX exports in models/ are versioned.
*.pt

# Cached sentence embeddings (re-computable, ~40 MB)
research/results/themes/emb_*.npy

# Collections created by API calls (app<id>_<timestamp>-<hex>): runtime data, not committed examples
data/snapshots/app[0-9]*_*/
